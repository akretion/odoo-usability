<odoo>

<record id="product_print_zpl_barcode_form" model="ir.ui.view">
    <field name="name">product_print_zpl_barcode.form</field>
    <field name="model">product.print.zpl.barcode</field>
    <field name="arch" type="xml">
        <form>
            <group name="step1">
                <field name="state" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="company_id" invisible="1"/>
                <field name="pricelist_id" readonly="state == 'step2'"/>
                <field name="label_size" readonly="state == 'step2'"/>
                <field name="label_type" readonly="state == 'step2'"/>
                <field name="nomenclature_id" readonly="state == 'step2'"/>
            </group>
            <group name="step2" invisible="state != 'step2'">
                <field name="zpl_file" filename="zpl_filename" />
                <field name="zpl_filename" invisible="1"/>
                <field name="zpl_printer_ip" required="state == 'step2'"/>
            </group>
            <group name="lines">
                <field name="line_ids" colspan="2" nolabel="1" readonly="state == 'step2'">
                    <list editable="bottom">
                        <field name="currency_id" invisible="1"/>
                        <field name="product_id" optional="hide" force_save="1"/>
                        <field name="product_name"/>
                        <field name="price_uom"/>
                        <field name="rule_id" optional="show"/>
                        <field name="barcode_type" optional="hide"/>
                        <field name="barcode" force_save="1"/>
                        <field name="price" invisible="barcode_type not in ('price', 'weight')"/>
                        <field name="quantity" invisible="barcode_type == 'product'" optional="show"/>
                        <field name="uom_id" invisible="barcode_type == 'product'" optional="show"/>
                        <field name="copies" />
                    </list>
                </field>
            </group>
            <footer>
                <button name="generate" type="object" string="Generate Labels" class="btn-primary" invisible="state != 'step1'"/>
                <button special="cancel" string="Cancel" class="btn-default" invisible="state != 'step1'"/>
                <button name="print_zpl" type="object" string="Print" class="btn-primary" invisible="state != 'step2'"/>
                <button special="cancel" string="Close" class="btn-default" invisible="state != 'step2'"/>
            </footer>
        </form>
    </field>
</record>

<record id="product_print_zpl_barcode_action" model="ir.actions.act_window">
    <field name="name">Generate Barcode</field>
    <field name="res_model">product.print.zpl.barcode</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

</odoo>
