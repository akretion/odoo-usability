<odoo>

<record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
    <field name="name">account_bank_journal_balance.account.journal.dashboard</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
    <field name="arch"  type="xml">
        <field name="kanban_dashboard" position="after">
            <field name="bank_default_account_balance_str"/>
        </field>
        <xpath expr="//div[@id='dashboard_bank_cash_balance']/.." position="attributes">
            <!-- Hide 'Running Balance' (dashboard.account_balance), replaced by 'Balance in GL' -->
            <attribute name="t-if">0 == 1</attribute>
        </xpath>
        <xpath expr="//div[@id='dashboard_bank_cash_balance']/.." position="after">
            <div id="bank_cash_balance_gl" class="row">
                <div id="bank_cash_balance_gl_label" class="col overflow-hidden text-start">
                    <span>Balance in GL</span>
                </div>
                <div id="bank_cash_balance_gl_value" class="col-auto text-end">
                    <span dir="ltr"><t t-out="record.bank_default_account_balance_str.raw_value"/></span>
                </div>
            </div>
        </xpath>
    </field>
</record>

</odoo>
