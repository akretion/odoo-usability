<odoo>


<record id="view_partner_form" model="ir.ui.view">
    <field name="name">agent.res.partner.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='sales_purchases']//group[@name='sale']/field[@name='user_id']" name="user_id" position="after">
            <field name="agent_id" invisible="parent_id"/>
        </xpath>
        <group name="misc" position="inside">
            <field name="agent"/>
        </group>
    </field>
</record>

<record id="view_partner_tree" model="ir.ui.view">
    <field name="name">agent.res.partner.tree</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
        <field name="user_id" position="after">
            <field name="agent_id" optional="hide"/>
        </field>
    </field>
</record>

<record id="view_res_partner_filter" model="ir.ui.view">
    <field name="name">agent.res.partner.search</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="arch" type="xml">
        <field name="user_id" position="after">
            <field name="agent_id"/>
        </field>
        <filter name="type_company" position="after">
            <separator/>
            <filter name="agent" string="Agents" domain="[('agent', '=', True)]"/>
        </filter>
        <filter name="salesperson" position="after">
            <filter name="agent_groupby" string="Agent" context="{'group_by': 'agent_id'}"/>
        </filter>
    </field>
</record>


</odoo>
