<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_valuation_xlsx_history_list" model="ir.ui.view">
        <field name="name">stock.valuation.xlsx.history.list</field>
        <field name="model">stock.valuation.xlsx.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="generated_at" />
                <field name="name" />
                <field name="report_type" />
                <field name="export_id" />
                <field name="location_id" />
                <field name="start_date" optional="hide" />
                <field name="end_date" />
                <field name="company_id" groups="base.group_multi_company" />
                <button name="action_download" type="object" string="Download"
                    icon="fa-download" />
            </list>
        </field>
    </record>
    <record id="stock_valuation_xlsx_history_form" model="ir.ui.view">
        <field name="name">stock.valuation.xlsx.history.form</field>
        <field name="model">stock.valuation.xlsx.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_download" type="object" string="Download"
                        class="oe_highlight" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="export_file" filename="name" />
                            <field name="export_id" />
                            <field name="report_type" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group>
                            <field name="generated_at" />
                            <field name="location_id" />
                            <field name="start_date" invisible="report_type != 'variation'" />
                            <field name="end_date" />
                        </group>
                    </group>
                    <group string="Parameters Used">
                        <field name="parameters" widget="jsonb" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="stock_valuation_xlsx_history_search" model="ir.ui.view">
        <field name="name">stock.valuation.xlsx.history.search</field>
        <field name="model">stock.valuation.xlsx.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="export_id" />
                <field name="location_id" />
                <filter name="valuation" string="Valuations"
                    domain="[('report_type', '=', 'valuation')]" />
                <filter name="variation" string="Variations"
                    domain="[('report_type', '=', 'variation')]" />
                <separator />
                <filter name="generated_at" string="Generation Date" date="generated_at" />
                <group expand="0" string="Group By">
                    <filter name="group_report_type" string="Report Type"
                        context="{'group_by': 'report_type'}" />
                    <filter name="group_export" string="Configuration"
                        context="{'group_by': 'export_id'}" />
                    <filter name="group_company" string="Company"
                        context="{'group_by': 'company_id'}" groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>
    <record id="stock_valuation_xlsx_history_action" model="ir.actions.act_window">
        <field name="name">Stock XLSX Export History</field>
        <field name="res_model">stock.valuation.xlsx.history</field>
        <field name="path">stock-valuation-history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="stock_valuation_xlsx_history_menu" name="Stock XLSX Export History"
        parent="stock.menu_warehouse_report" action="stock_valuation_xlsx_history_action"
        groups="stock.group_stock_user" sequence="120" />
</odoo>
